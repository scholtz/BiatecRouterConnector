<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Ludovit Scholtz</Authors>
		<Company>Scholtz And Co</Company>
		<PackageProjectUrl>https://github.com/scholtz/BiatecRouterConnector</PackageProjectUrl>
		<RepositoryUrl>https://github.com/scholtz/BiatecRouterConnector</RepositoryUrl>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!--
			CI passes -p:VersionIncrement=<github.run_number>, so every push to master gets a
			strictly higher, unique package version. Local/dev builds default the increment to 0.
			AssemblyVersion can't hold the full yyyyMMddHH date (each component must be <= 65535,
			enforced by the CLR/compiler), so it uses MMdd instead (max 1231) - still bumps on every
			build without ever exceeding the limit.

			IMPORTANT: pass -p:VersionIncrement=(value) to every dotnet CLI step for a given build
			(restore AND build AND pack), not just build/pack. "dotnet restore" doesn't compile, but
			it still evaluates this project and can write GenerateAssemblyInfo's incremental cache
			file (obj/*.AssemblyInfoInputs.cache) using whatever VersionIncrement it was given. If a
			later build (even with the "no restore" flag) passes a different VersionIncrement and
			sees that cache file, MSBuild's Inputs/Outputs up-to-date check can wrongly treat
			AssemblyInfo.cs as already current and skip regenerating it, silently baking the WRONG
			VersionIncrement into AssemblyVersion/FileVersion while the NuGet package Version (read
			directly, not through that cache) stays correct. Confirmed by direct testing; see ci.yml,
			which passes the same VersionIncrement to its Restore, Build, and Pack steps in the
			publish job for this reason.
		-->
		<VersionIncrement Condition="'$(VersionIncrement)' == ''">0</VersionIncrement>
		<Version>1.0.$(VersionIncrement).$([System.DateTime]::Now.ToString(yyyyMMddHH))</Version>
		<AssemblyVersion>1.0.$(VersionIncrement).$([System.DateTime]::Now.ToString(MMdd))</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>algorand,trading,dex swap,dex aggregator,trade,arc14,arc76,dex,aggregator,algo,swap</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- CA1708 fires on the NSwag-generated Generated.AMMType/AmmType pair; the names come from the
		     router's OpenAPI schema and aren't ours to rename. -->
		<NoWarn>$(NoWarn);CA1708</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Algorand4" Version="4.7.4.2026071920" />
		<PackageReference Include="AlgorandARC76Account" Version="1.1.0" />
		<PackageReference Include="NSwag.MSBuild" Version="14.7.1" PrivateAssets="all" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<PropertyGroup>
		<NSwagGenerateExceptionClasses>true</NSwagGenerateExceptionClasses>
	</PropertyGroup>

	<!--
		BeforeTargets="CoreCompile" (not "Compile"): the generated file must be added to @(Compile)
		*inside* this target so MSBuild picks it up dynamically during this same build. A top-level
		<ItemGroup> with this wildcard is evaluated once, before any target runs, so on a truly clean
		checkout (no obj\BiatecRouterApiClient.cs yet, e.g. the first build in CI) it would match
		nothing and the build would fail with "type or namespace 'Generated' does not exist" - even
		though the Exec below just generated the file a moment earlier.
	-->
	<Target Name="GenerateBiatecRouterApiClient" BeforeTargets="CoreCompile">
		<!--
			Forward slashes only: this Exec command runs through /bin/sh on Linux/macOS CI runners,
			where backslash is not a path separator (it's just a literal character in the resulting
			argument), so a hardcoded "\tools\Net100\..." path silently resolves to a nonexistent file
			there even though it works fine on Windows. Forward slashes are accepted by both dotnet/
			MSBuild on Windows and the shell on Linux/macOS.
		-->
		<Exec Command="dotnet --roll-forward LatestMajor &quot;$(PkgNSwag_MSBuild)/tools/Net100/dotnet-nswag.dll&quot; run &quot;$(MSBuildProjectDirectory)/nswag.json&quot; /variables:Configuration=$(Configuration)" />
		<ItemGroup>
			<Compile Include="obj/**/BiatecRouterApiClient.cs" Link="Generated/BiatecRouterApiClient.cs" Visible="false" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>

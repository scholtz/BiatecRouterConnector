{ "openapi": "3.0.4", "info": { "title": "AVM Trade Reporter API", "description": "# AVM Trade Reporter \u2013 Developer Guide\n\nShort overview\n- ASP.NET Core (.NET 8) Web API + SignalR service for streaming Algorand DEX activity (trades, liquidity, pools, blocks)\n- Ingests data from Algod/Gossip, enriches via protocol-specific processors (Pact, Tiny, Biatec)\n- Indexes documents in Elasticsearch and broadcasts live updates to clients via SignalR\n- Optional Redis cache for assets and pools, plus background services for continuous operation\n\nNotes\n- Swagger defines an API key scheme named oauth2 (ARC-0014 Algorand authentication transaction transmitted in Authorization header)\n", "version": "v1" }, "paths": { "/api/aggregated-pool": { "get": { "tags": [ "AggregatedPool" ], "parameters": [ { "name": "assetIdA", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdB", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "offset", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 0 } }, { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 100 } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AggregatedPool" } } } } }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/aggregated-pool/reload": { "get": { "tags": [ "AggregatedPool" ], "parameters": [ { "name": "assetIdA", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdB", "in": "query", "schema": { "type": "integer", "format": "int64" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AggregatedPool" } } } }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/asset": { "get": { "tags": [ "Asset" ], "parameters": [ { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "offset", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 0 } }, { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 100 } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/BiatecAsset" } } } } } } } }, "/api/asset/image/{assetId}": { "get": { "tags": [ "Asset" ], "parameters": [ { "name": "assetId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } } ], "responses": { "200": { "description": "OK" } } } }, "/api/indexer/status": { "get": { "tags": [ "Indexer" ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Indexer" } } } }, "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/liquidity": { "get": { "tags": [ "Liquidity" ], "parameters": [ { "name": "assetIdA", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdB", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "txId", "in": "query", "schema": { "type": "string" } }, { "name": "offset", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 0 } }, { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 100 } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Liquidity" } } } } } } } }, "/api/pool": { "get": { "tags": [ "Pool" ], "parameters": [ { "name": "assetIdA", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdB", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "address", "in": "query", "schema": { "type": "string" } }, { "name": "protocol", "in": "query", "schema": { "$ref": "#/components/schemas/DEXProtocol" } }, { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 100 } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pool" } } } } }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/pool/stats": { "get": { "tags": [ "Pool" ], "parameters": [ { "name": "assetIdA", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdB", "in": "query", "schema": { "type": "integer", "format": "int64" } } ], "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/search": { "get": { "tags": [ "Search" ], "parameters": [ { "name": "q", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } } } }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } }, "security": [ { "oauth2": [ ] } ] } }, "/api/trade": { "get": { "tags": [ "Trade" ], "parameters": [ { "name": "assetIdIn", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "assetIdOut", "in": "query", "schema": { "type": "integer", "format": "int64" } }, { "name": "txId", "in": "query", "schema": { "type": "string" } }, { "name": "offset", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 0 } }, { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 100 } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Trade" } } } } } } } } }, "components": { "schemas": { "AMMType": { "enum": [ "OldAMM", "StableSwap", "ConcentratedLiquidityAMM" ], "type": "string" }, "AggregatedPool": { "type": "object", "properties": { "id": { "type": "string", "nullable": true, "readOnly": true }, "assetIdA": { "type": "integer", "format": "int64" }, "assetIdB": { "type": "integer", "format": "int64" } }, "additionalProperties": false }, "AssetType": { "enum": [ "ASA", "ARC200" ], "type": "string" }, "BiatecAsset": { "required": [ "index", "params" ], "type": "object", "properties": { "index": { "type": "integer", "format": "int64" }, "type": { "$ref": "#/components/schemas/AssetType" } }, "additionalProperties": false }, "DEXProtocol": { "enum": [ "Pact", "Tiny", "Biatec" ], "type": "string" }, "Indexer": { "type": "object", "properties": { "id": { "type": "string", "nullable": true }, "round": { "type": "integer", "format": "int64" }, "genesisId": { "type": "string", "nullable": true }, "updated": { "type": "string", "format": "date-time" } }, "additionalProperties": false }, "Liquidity": { "type": "object", "properties": { "assetIdA": { "type": "integer", "format": "int64" }, "assetIdB": { "type": "integer", "format": "int64" } }, "additionalProperties": false }, "Pool": { "type": "object", "properties": { "poolAddress": { "type": "string", "nullable": true }, "poolAppId": { "type": "integer", "format": "int64" }, "protocol": { "$ref": "#/components/schemas/DEXProtocol" } }, "additionalProperties": false }, "ProblemDetails": { "type": "object", "properties": { "type": { "type": "string", "nullable": true }, "title": { "type": "string", "nullable": true }, "status": { "type": "integer", "format": "int32", "nullable": true }, "detail": { "type": "string", "nullable": true }, "instance": { "type": "string", "nullable": true } }, "additionalProperties": { } }, "SearchResponse": { "type": "object", "properties": { }, "additionalProperties": false }, "Trade": { "type": "object", "properties": { "assetIdIn": { "type": "integer", "format": "int64" }, "assetIdOut": { "type": "integer", "format": "int64" } }, "additionalProperties": false } }, "securitySchemes": { "oauth2": { "type": "apiKey", "description": "ARC-0014 Algorand authentication transaction", "name": "Authorization", "in": "header" } } } }